# API server
PORT=8787
HOST=0.0.0.0

# Comma-separated origins. Empty = reflect any origin (local demo).
# CORS_ORIGIN=http://localhost:5173,https://your-site.example

# Override the local single-profile library file.
# On Vercel the API defaults to /tmp/reognime-library.json (ephemeral).
# LIBRARY_FILE=./server/data/library.json

# Frontend: point the SPA at a remote API. Defaults to /api/v1
# VITE_API_BASE_URL=https://your-api.example/api/v1

# Otakudesu watch layer (defaults shown). Change only if the provider moves.
# OTAKUDESU_API_BASE=https://www.sankavollerei.web.id/anime
# OTAKUDESU_SITEMAP_URL=https://otakudesu.or.at/series-sitemap.xml
