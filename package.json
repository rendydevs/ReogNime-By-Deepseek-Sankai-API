{
  "name": "reognime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ReogNime — a quiet anime streaming room with Indonesian subtitles, powered by a documented REST API.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite --config client/vite.config.ts\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node scripts/seed-catalog.mjs",
    "test": "node --test server",
    "typecheck": "tsc --noEmit -p client/tsconfig.json",
    "seo:sitemap": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
